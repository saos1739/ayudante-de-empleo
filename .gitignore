!postulaciones/*.example.md
plantillas/*
!plantillas/*.example.md

# Herramientas de desarrollo
.pytest_cache/
.ruff_cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.venv/
env/
venv/

# Estado de la corrida en la nube (vive en la rama radar-state, no en main)
.estado/

# Logs y temporales
*.log
scratch/
.system_generated/
