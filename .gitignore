# Entorno y claves
.env
.env.local

# Base de datos y datos locales
data/
*.db
*.sqlite3

# Datos personales: solo se versionan las versiones de ejemplo (*.example.md)
perfil/cv.md
perfil_candidato.md
tracking_postulaciones.md
