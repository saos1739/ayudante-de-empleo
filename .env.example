# Copiá este archivo como .env y completá tus valores. El .env nunca se versiona.

# --- Correo (Gmail SMTP) ---
# Cuenta que envía el resumen y su contraseña de aplicación de Google (no la contraseña normal).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Quién recibe el resumen. Si queda vacío se usa GMAIL_USER.
RADAR_DESTINATARIO=

# --- IA (opcional) ---
GEMINI_API_KEY=

# --- Contacto que firma las cartas ---
# Si quedan vacíos se toma la línea "**Contacto:**" de perfil/cv.md.
CANDIDATO_TELEFONO=
CANDIDATO_EMAIL=

# --- Opcional ---
# Ruta de la base SQLite. Por defecto: %LOCALAPPDATA%\RadarEmpleo\radar.db en Windows.
RADAR_DB=

# --- WhatsApp vía CallMeBot (se usan desde la Fase 2) ---
# WHATSAPP_PHONE=
# CALLMEBOT_APIKEY=
